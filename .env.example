# --- Database ---
POSTGRES_USER=karai
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=karai
DATABASE_URL=postgresql+psycopg2://karai:change_me_dev_only@db:5432/karai

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- Field-level encryption (prototype-grade; production needs KMS/HSM) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=change_me_to_a_long_random_value

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=100

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
